{
  "name": "frontend-testing-blueprint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:stories": "vitest run --project storybook",
    "test:storybook-smoke": "playwright test --config playwright.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:pr": "playwright test --project=chromium",
    "test:e2e:coverage": "node scripts/run-e2e-coverage.mjs",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "test:mutation:changed": "node scripts/stryker-incremental.mjs",
    "ci:test": "node scripts/run-ci-unit.mjs",
    "ci:test:stories": "vitest run --project storybook --reporter=default --reporter=junit --outputFile.junit=artifacts/storybook/junit.xml",
    "test:impact": "node scripts/test-impact.mjs",
    "test:impact:self": "node --test scripts/*.test.mjs",
    "test:receipt": "node scripts/test-receipt.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:impact:self && pnpm test:coverage && pnpm test:stories && pnpm build-storybook && pnpm test:storybook-smoke && pnpm build",
    "prepare": "node scripts/prepare.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "4.1.11",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-storybook": "10.5.5",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "29.1.1",
    "lint-staged": "17.2.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "prettier": "3.9.6",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
